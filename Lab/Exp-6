<!DOCTYPE html>
<html>
<head>
    <title>Online Cake Ordering System</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #fff0f3;
            margin: 0;
        }
        header {
            background: #b8325c;
            color: white;
            text-align: center;
            padding: 20px;
        }
        .container {
            width: 85%;
            margin: 25px auto;
        }
        .cakes {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }
        .cake {
            background: white;
            padding: 18px;
            width: 200px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 2px 8px #ccc;
        }
        button {
            background: #b8325c;
            color: white;
            border: none;
            padding: 10px 15px;
            cursor: pointer;
            border-radius: 5px;
        }
        input, select {
            padding: 9px;
            margin: 6px;
        }
        #cart {
            background: white;
            padding: 15px;
            margin-top: 20px;
            border-radius: 10px;
        }
    </style>
</head>
<body>

<header>
    <h1>Sweet Treats Cake Shop</h1>
    <p>Order your favourite cakes online</p>
</header>

<div class="container">
    <h2>Available Cakes</h2>

    <div class="cakes">
        <div class="cake">
            <h3>Chocolate Cake</h3>
            <p>Rich chocolate flavour</p>
            <p>₹500</p>
            <button onclick="addToCart('Chocolate Cake', 500)">Add to Cart</button>
        </div>

        <div class="cake">
            <h3>Vanilla Cake</h3>
            <p>Classic vanilla flavour</p>
            <p>₹400</p>
            <button onclick="addToCart('Vanilla Cake', 400)">Add to Cart</button>
        </div>

        <div class="cake">
            <h3>Black Forest Cake</h3>
            <p>Chocolate and cherry</p>
            <p>₹600</p>
            <button onclick="addToCart('Black Forest Cake', 600)">Add to Cart</button>
        </div>

        <div class="cake">
            <h3>Red Velvet Cake</h3>
            <p>Soft red velvet layers</p>
            <p>₹700</p>
            <button onclick="addToCart('Red Velvet Cake', 700)">Add to Cart</button>
        </div>
    </div>

    <div id="cart">
        <h2>Shopping Cart</h2>
        <ul id="cartItems"></ul>
        <h3 id="total">Total: ₹0</h3>
    </div>

    <h2>Order Details</h2>
    <form onsubmit="placeOrder(event)">
        <input type="text" id="customer" placeholder="Customer Name" required>
        <input type="tel" id="phone" placeholder="Phone Number" required>
        <br>
        <input type="text" id="address" placeholder="Delivery Address" required>
        <input type="date" id="deliveryDate" required>
        <br>
        <select id="size">
            <option>1/2 kg</option>
            <option>1 kg</option>
            <option>2 kg</option>
        </select>
        <input type="text" id="message" placeholder="Cake message (optional)">
        <br><br>
        <button type="submit">Place Order</button>
    </form>

    <h3 id="result"></h3>
</div>

<script>
    let cart = [];
    let total = 0;

    function addToCart(name, price) {
        cart.push({name: name, price: price});
        total += price;
        displayCart();
    }

    function displayCart() {
        let list = document.getElementById("cartItems");
        list.innerHTML = "";

        cart.forEach(function(item, index) {
            let li = document.createElement("li");
            li.innerHTML = item.name + " - ₹" + item.price +
                ' <button onclick="removeItem(' + index + ')">Remove</button>';
            list.appendChild(li);
        });

        document.getElementById("total").innerText = "Total: ₹" + total;
    }

    function removeItem(index) {
        total -= cart[index].price;
        cart.splice(index, 1);
        displayCart();
    }

    function placeOrder(event) {
        event.preventDefault();

        if (cart.length === 0) {
            alert("Please add a cake to your cart.");
            return;
        }

        let name = document.getElementById("customer").value;

        document.getElementById("result").innerText =
            "Thank you, " + name + "! Your order has been placed. Total: ₹" + total;

        cart = [];
        total = 0;
        displayCart();
        event.target.reset();
    }
</script>

</body>
</html>
